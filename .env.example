# WooCommerce (server-only; never prefix with NEXT_PUBLIC_)
# Leave WC_URL empty to use the in-memory mock store. When set (https only,
# e.g. https://shop.example.pk) the other three are required.
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Secret typed into WP admin > WooCommerce > Settings > Advanced > Webhooks
WC_WEBHOOK_SECRET=

# WhatsApp Cloud API (post-MVP — not needed yet)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Object storage (S3-compatible, e.g. Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
