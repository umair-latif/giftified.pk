# WooCommerce (server-only; never prefix with NEXT_PUBLIC_)
# Leave WC_URL empty to use the in-memory mock store (development only — a production
# build refuses to start commerce without WC_URL unless COMMERCE_MOCK=1 is set). When set (https only,
# e.g. https://shop.example.pk) the other three are required.
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Secret typed into WP admin > WooCommerce > Settings > Advanced > Webhooks
WC_WEBHOOK_SECRET=
# COMMERCE_MOCK=1   # demo/e2e builds only

# WhatsApp Cloud API (post-MVP — not needed yet)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Object storage: Cloudflare R2 (or any S3-compatible service). Guide: docs/ops/storage-r2.md
# Endpoint WITHOUT the bucket name: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Leave empty for in-memory dev storage (a production build refuses that unless COMMERCE_MOCK=1).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Background jobs: Inngest. On Vercel the Inngest integration sets these two (Production).
# Locally leave them empty; run `npx inngest-cli@latest dev` and set INNGEST_DEV=1 to run jobs.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Production: your domain, so Inngest calls it instead of *.vercel.app
# INNGEST_SERVE_ORIGIN=https://giftified.microw.me
# INNGEST_DEV=1

# Print-file download links in WP admin (docs/ops/order-pipeline.md). Both optional:
# FILES_LINK_SECRET defaults to a secret derived from WC_WEBHOOK_SECRET;
# APP_URL defaults to Vercel's production domain.
# FILES_LINK_SECRET=
# APP_URL=https://giftified.microw.me

# Accounts (task 20). Guide: docs/ops/accounts.md
# Signs session cookies and reset links; defaults to a secret derived from WC_WEBHOOK_SECRET.
# AUTH_SECRET=
# "Continue with Google" (button hidden while empty). Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset emails (Resend). Production refuses to start the reset flow without them.
RESEND_API_KEY=
# EMAIL_FROM="Giftified.pk <hello@giftified.pk>"

# Data retention (task 24, docs/ops/order-pipeline.md): print files and guest designs are deleted
# this many days after an order is completed/cancelled. Default 30; whole number >= 7.
# RETENTION_DAYS=30

# Designers: signed-in accounts with these emails (comma-separated) may publish designs
# and manage sample photos. Add a person = add their email here and redeploy.
# (The older name TEMPLATE_EDITOR_EMAILS still works; both lists count.)
DESIGNER_EMAILS=
